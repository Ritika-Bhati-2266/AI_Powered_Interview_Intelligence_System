# LLM Provider — set GROQ_API_KEY to use Groq cloud; omit to fall back to local Ollama
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Ollama fallback (only used when GROQ_API_KEY is not set)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=llama3.2:latest

# Whisper model (tiny/base/small/medium/large)
WHISPER_MODEL=base

# Flask session secret (set a fixed value on Render to persist sessions across restarts)
# SECRET_KEY=your_random_secret_here
