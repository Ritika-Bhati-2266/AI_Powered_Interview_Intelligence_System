# Groq LLM Provider
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=openai/gpt-oss-120b

# Whisper model (tiny/base/small/medium/large)
WHISPER_MODEL=base

# Code execution via Piston API (no key needed — https://emkc.org/api/v2/piston/execute)
# Legacy Judge0 key kept for backward compat but not required:
# JUDGE0_API_KEY=
PISTON_API_URL=https://emkc.org/api/v2/piston/execute

# Flask session secret (set a fixed value on Render to persist sessions across restarts)
# SECRET_KEY=your_random_secret_here
